{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIPHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 120 },
      { "Endpoint": "*", "Period": "1h", "Limit": 2000 },
      { "Endpoint": "post:/api/v1/auth/login", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/v1/auth/register/customer", "Period": "1h", "Limit": 10 },
      { "Endpoint": "post:/api/v1/auth/register/vendor", "Period": "1h", "Limit": 10 },
      { "Endpoint": "post:/api/v1/auth/forgot-password", "Period": "1h", "Limit": 5 },
      { "Endpoint": "post:/api/v1/chat/conversations/*/messages", "Period": "1m", "Limit": 30 }
    ]
  },
  "AllowedHosts": "*"
}
